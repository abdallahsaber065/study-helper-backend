# Study Assistant Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Study Assistant API"
DEBUG=true
VERSION="0.1.0"
ENVIRONMENT="development"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST="127.0.0.1"
PORT=8000

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# IMPORTANT: Generate a secure random string for production
# You can use: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-here-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://study_assistant_user:Password_00110011@localhost:5432/study_assistant"

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_DB=0

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=["application/pdf","text/plain","text/markdown"]

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PER="minute"

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================
# Add your API keys here
OPENAI_API_KEY="sk-your-openai-api-key-here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"
GEMINI_API_KEY="AIzaSyAbxhGde3vvPVFKnqopsSMuYZH2D2oLOjI"
AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=3

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
MAIL_USERNAME="studyhelper.website@gmail.com"
MAIL_PASSWORD="rgvf qcdi rwsr ksgo"
MAIL_FROM="studyhelper.website@gmail.com"
MAIL_PORT=587   
MAIL_SERVER="smtp.gmail.com"
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
ENABLE_METRICS=true
LOG_LEVEL="INFO"
LOG_FORMAT="json"
